```

То есть:

```json
{
  "snapshot": {
    "state_vector": {},
    "lens_annotations": []
  },
  "transition": {
    "from_snapshot": "snap_001",
    "to_snapshot": "snap_002",
    "delta": {}
  },
  "loop_signature": {
    "trigger": "...",
    "state": "...",
    "behavior": "...",
    "stc": "...",
    "ltc": "..."
  }
}
```

