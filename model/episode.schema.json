{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3.local/model/episode.schema.json",
  "title": "CBT Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "source",
    "observed",
    "derived"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^episode-[0-9]{8}-[0-9]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "situation",
        "automatic_thought",
        "emotion",
        "behavior",
        "physical",
        "short_term_consequence",
        "long_term_consequence"
      ],
      "properties": {
        "situation": {
          "$ref": "#/$defs/observed_field"
        },
        "trigger": {
          "$ref": "#/$defs/observed_field"
        },
        "actor": {
          "$ref": "#/$defs/observed_field"
        },
        "quote": {
          "$ref": "#/$defs/observed_field"
        },
        "automatic_thought": {
          "$ref": "#/$defs/observed_field"
        },
        "emotion": {
          "$ref": "#/$defs/observed_field"
        },
        "behavior": {
          "$ref": "#/$defs/observed_field"
        },
        "physical": {
          "$ref": "#/$defs/observed_field"
        },
        "short_term_consequence": {
          "$ref": "#/$defs/observed_field"
        },
        "long_term_consequence": {
          "$ref": "#/$defs/observed_field"
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "trigger_annotations",
        "actor_annotations",
        "cognition_annotations",
        "emotion_annotations",
        "behavior_annotations"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "trigger_annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger_annotation"
          }
        },
        "actor_annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor_annotation"
          }
        },
        "cognition_annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cognition_annotation"
          }
        },
        "emotion_annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emotion_annotation"
          }
        },
        "behavior_annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/behavior_annotation"
          }
        },
        "outcome_annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome_annotation"
          },
          "default": []
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graph_relation"
          },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "observed_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source_quote"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "source_quote": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "observed_ref_field": {
      "type": "string",
      "enum": [
        "observed.situation",
        "observed.trigger",
        "observed.actor",
        "observed.quote",
        "observed.behavior",
        "observed.short_term_consequence",
        "observed.long_term_consequence",
        "observed.automatic_thought",
        "observed.emotion",
        "observed.physical"
      ]
    },
    "emotion_label": {
      "type": "string",
      "enum": [
        "нейтраль/мешанные",
        "любовь/тепло",
        "радость",
        "отвращение",
        "стыд",
        "грусть",
        "злость",
        "страх"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^node-[0-9]+$"
        },
        "node_origin": {
          "type": "string",
          "enum": [
            "observed",
            "support"
          ],
          "default": "observed"
        },
        "kind": {
          "type": "string",
          "enum": [
            "actor",
            "cognition",
            "emotion",
            "quote",
            "behavior",
            "short_outcome",
            "long_outcome"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_field": {
          "type": "string",
          "enum": [
            "observed.actor",
            "observed.quote",
            "observed.automatic_thought",
            "observed.emotion",
            "observed.behavior",
            "observed.short_term_consequence",
            "observed.long_term_consequence"
          ]
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "trigger_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^trigger-annotation-[0-9]+$"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^node-[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "type": "string",
          "enum": [
            "external",
            "internal",
            "social",
            "physical",
            "memory",
            "thought"
          ]
        },
        "source_field": {
          "type": "string",
          "enum": [
            "observed.trigger",
            "observed.situation",
            "observed.automatic_thought"
          ]
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "actor_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "label",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^actor-annotation-[0-9]+$"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^node-[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "type": "string",
          "enum": [
            "self",
            "other",
            "group",
            "institution",
            "unknown"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_field": {
          "type": "string",
          "enum": [
            "observed.actor",
            "observed.quote",
            "observed.situation"
          ]
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "cognition_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "kind",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cognition-annotation-[0-9]+$"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^node-[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "evaluation",
            "prediction",
            "rule",
            "meaning",
            "memory",
            "image",
            "urge",
            "question"
          ]
        },
        "source_field": {
          "const": "observed.automatic_thought"
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "emotion_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "valence",
        "arousal",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^emotion-annotation-[0-9]+$"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^node-[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "$ref": "#/$defs/emotion_label"
        },
        "intensity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "valence": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "arousal": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "source_field": {
          "const": "observed.emotion"
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "behavior_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^behavior-annotation-[0-9]+$"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^node-[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "type": "string",
          "enum": [
            "approach",
            "avoid",
            "freeze",
            "attack",
            "submit",
            "compensate",
            "distract"
          ]
        },
        "source_field": {
          "const": "observed.behavior"
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "outcome_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "horizon",
        "type",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^outcome-annotation-[0-9]+$"
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^node-[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "horizon": {
          "type": "string",
          "enum": [
            "short_term",
            "long_term"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "relief",
            "control",
            "avoidance_cost",
            "unresolved",
            "escalation",
            "connection",
            "learning",
            "neutral_mixed"
          ]
        },
        "source_field": {
          "type": "string",
          "enum": [
            "observed.short_term_consequence",
            "observed.long_term_consequence"
          ]
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "graph_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "from_ref",
        "to_ref",
        "source_field",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^relation-[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "belongs_to",
            "derived_from",
            "precedes",
            "leads_to",
            "co_occurs_with",
            "elicits",
            "expressed_as",
            "reinforces",
            "contrasts_with",
            "acts_in",
            "occurs_in"
          ]
        },
        "from_ref": {
          "type": "string",
          "pattern": "^(episode|observed\\.(situation|trigger|actor|quote|behavior|short_term_consequence|long_term_consequence|automatic_thought|emotion|physical)|node-[0-9]+)$"
        },
        "to_ref": {
          "type": "string",
          "pattern": "^(episode|observed\\.(situation|trigger|actor|quote|behavior|short_term_consequence|long_term_consequence|automatic_thought|emotion|physical)|node-[0-9]+)$"
        },
        "source_field": {
          "$ref": "#/$defs/observed_ref_field"
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
