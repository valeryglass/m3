TELEGRAM_BOT_TOKEN=
M3_TELEGRAM_ADMIN_CHAT_IDS=
M3_TELEGRAM_OWNER_CHAT_ID=

# Runtime mode.
# Local/free mode keeps /10q deterministic and makes non-10Q extraction fail safely.
M3_APP_MODE=ml
M3_CAPTURE_EXTRACTION_PROVIDER=unavailable

# Production non-10Q extraction.
# To enable /1t, /3b, and /1a schema extraction in beta production, set:
# M3_APP_MODE=production
# M3_CAPTURE_EXTRACTION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
M3_DEEPSEEK_BASE_URL=https://api.deepseek.com
M3_CAPTURE_EXTRACTION_MODEL=

# Profile report rendering.
# auto means ml -> deterministic profile, production -> LLM profile.
# Production LLM profile rewrites safe InsightPayload/report facts only.
M3_PROFILE_REPORT_MODE=auto
M3_PROFILE_LLM_PROVIDER=unavailable
M3_PROFILE_LLM_MODEL=

# Optional OpenAI compatibility provider.
# Use only with M3_CAPTURE_EXTRACTION_PROVIDER=openai.
OPENAI_API_KEY=

M3_EPISODE_DIR=data/episodes
M3_RUNTIME_SESSION_DIR=data/runtime-sessions
M3_RUNTIME_FLOW_DIR=data/runtime-flows
M3_USERLIST_PATH=data/userlist/users.json
M3_ANNOTATION_RUN_DIR=
M3_ANNOTATION_RUN_ROOT=data/annotation-runs
M3_REPORT_MIN_COUNT=2
M3_UX_EVENT_LOG=data/ux-events/events.jsonl
M3_JOURNAL_LOG=data/journal/events.jsonl
M3_UX_IDLE_AFTER_SEC=7200
M3_INITIAL_SESSION_TTL_SEC=600
M3_TONE_CONFIG=app/tone.yaml

# Audio transcription runtime for local and Docker smoke.
M3_TRANSCRIPTION_PROVIDER=whisper
M3_WHISPER_COMMAND=.venv/bin/whisper
M3_WHISPER_MODEL=tiny
M3_WHISPER_LANGUAGE=ru
M3_AUDIO_TEMP_DIR=data/runtime-audio
M3_INTAKE_TRANSCRIPT_DIR=data/intake-transcripts
M3_CAPTURE_ARTIFACT_DIR=data/capture-artifacts
M3_CAPTURE_EXTRACTION_DIR=data/capture-extractions
M3_CAPTURE_DEBUG_DIR=data/capture-debug
M3_CAPTURE_DEBUG_RAW_PROVIDER_OUTPUT=0
M3_AUDIO_MAX_DURATION_SEC=300
M3_AUDIO_MAX_FILE_SIZE_BYTES=20971520
