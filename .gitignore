# Ignore immutable content directories while keeping the folders themselves.
raw/**
sources/**
# Legacy local episode artifacts from the pre-app layout.
episodes/*.json
data/episodes/*.json
data/runtime-sessions/*.json
data/runtime-flows/**
data/userlist/*.json
data/ux-events/*.jsonl
data/annotation-work/**
data/annotation-runs/**
data/intake-transcripts/**
data/backups/**
data/exports/**
data/reports/**
.env

!raw/
!sources/
!data/
!data/episodes/
!data/runtime-sessions/
!data/runtime-flows/
!data/userlist/
!data/ux-events/
!data/annotation-work/
!data/annotation-runs/
!data/intake-transcripts/
!data/backups/
!data/exports/
!data/reports/
!data/episodes/.gitkeep
!data/runtime-sessions/.gitkeep
!data/runtime-flows/.gitkeep
!data/userlist/.gitkeep
!data/ux-events/.gitkeep
!data/annotation-runs/.gitkeep
!data/intake-transcripts/.gitkeep
!data/exports/.gitkeep
!data/exports/map-payload/
!data/exports/map-payload/**
!data/exports/hex-world/
!data/exports/hex-world/.gitkeep

# Ignore user-local Obsidian workspace state.
.obsidian/

# Ignore local Codex environment marker.
.codex

# Ignore Python local build/test artifacts.
.venv/
build/
dist/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
